<section class="tf-work-management" id="work-management">
    <div class="wm-bg wm-bg-top"></div>
    <div class="wm-bg wm-bg-bottom"></div>

    <div class="wm-container">
        <div class="wm-switcher" role="tablist" aria-label="Work management views">
            <button class="wm-switcher-item" type="button" data-wm-tab="knowledge">Knowledge</button>
            <button class="wm-switcher-item" type="button" data-wm-tab="people">People</button>
            <button class="wm-switcher-item wm-active" type="button" data-wm-tab="process">Process</button>
            <button class="wm-switcher-item" type="button" data-wm-tab="platform">Platform</button>
        </div>

        <header class="wm-heading">
            <h2>Manage all <span>your work</span> from one place.</h2>
            <p>Plan projects, organize tasks, and keep your team moving forward without jumping between tools.</p>
        </header>

        <div class="wm-content">
            <div class="wm-story" aria-live="polite">
                <button class="wm-story-item" type="button" data-wm-story="automate">
                    <span class="wm-story-line"></span>
                    <span class="wm-story-copy">
                        <strong>Anyone can organize work in TaskFlow.</strong>
                    </span>
                </button>

                <button class="wm-story-item wm-selected" type="button" data-wm-story="projects">
                    <span class="wm-story-line"></span>
                    <span class="wm-story-copy">
                        <strong>Manage projects and tasks.</strong>
                        <small>Plan. Assign. Track. Mark as complete. All without leaving the conversation.</small>
                        <span class="wm-link">Learn about projects <b>→</b></span>
                    </span>
                </button>

                <button class="wm-story-item" type="button" data-wm-story="simple">
                    <span class="wm-story-line"></span>
                    <span class="wm-story-copy">
                        <strong>A simpler way to get started.</strong>
                    </span>
                </button>

                <div class="wm-stat">
                    <strong>35%</strong>
                    <span>less time spent switching between tools.</span>
                </div>
            </div>

            <div class="wm-product" aria-label="TaskFlow project management preview">
                <div class="wm-window">
                    <div class="wm-window-bar">
                        <div class="wm-dots"><i></i><i></i><i></i></div>
                        <div class="wm-window-title">Customer Projects <span>Updated 2 min ago</span></div>
                        <div class="wm-window-actions"><span>↩</span><span>↪</span><span>◷</span></div>
                    </div>

                    <div class="wm-appbar">
                        <div class="wm-app-search">⌕ <span>Search TaskFlow</span></div>
                        <div class="wm-app-actions"><span>Updated 2 min ago</span><span class="wm-mini-avatar">T</span><span class="wm-mini-avatar second">H</span><button>Share</button><span>☆</span></div>
                    </div>

                    <div class="wm-board-header">
                        <div>
                            <h3>Customer Projects</h3>
                            <p>Track work, owners, priorities, and deadlines in one place.</p>
                        </div>
                        <div class="wm-board-controls"><button>▣</button><button>☷</button><button class="active">Kanban</button><button>Group by Status⌄</button></div>
                    </div>

                    <div class="wm-board">
                        <div class="wm-column wm-progress">
                            <div class="wm-column-head"><strong>In Progress</strong><span>3</span></div>
                            <article class="wm-task"><h4>Fix checkout flow</h4><p>Owner <b>Minh</b> · Requestor <b>Lan</b></p><div><em>P1</em><span>Due 1/3</span><span>Web team</span></div></article>
                            <article class="wm-task"><h4>Update landing page</h4><p>Owner <b>Huy</b> · Requestor <b>An</b></p><div><em>P2</em><span>Due 1/5</span><span>Design</span></div></article>
                            <button class="wm-add">＋ Add item</button>
                        </div>

                        <div class="wm-column wm-urgent">
                            <div class="wm-column-head"><strong>Urgent</strong><span>2</span></div>
                            <article class="wm-task"><h4>Troubleshoot login</h4><p>Owner <b>Mai</b> · Requestor <b>Nam</b></p><div><em>P1</em><span>Due 11/5</span><span>Backend</span></div></article>
                            <article class="wm-task"><h4>Review pricing update</h4><p>Owner <b>Vy</b> · Requestor <b>Tom</b></p><div><em>P2</em><span>Due 12/5</span><span>Product</span></div></article>
                            <button class="wm-add">＋ Add item</button>
                        </div>

                        <div class="wm-column wm-resolved">
                            <div class="wm-column-head"><strong>Resolved</strong><span>2</span></div>
                            <article class="wm-task"><h4>Investigate performance</h4><p>Owner <b>Linh</b> · Requestor <b>Quân</b></p><div><em>P1</em><span>Due 12/4</span><span>Web team</span></div></article>
                            <article class="wm-task"><h4>Adjust form links</h4><p>Owner <b>Hà</b> · Requestor <b>Vy</b></p><div><em>P2</em><span>Due 1/4</span><span>Design</span></div></article>
                            <button class="wm-add">＋ Add item</button>
                        </div>

                        <div class="wm-column wm-ongoing">
                            <div class="wm-column-head"><strong>Ongoing</strong><span>2</span></div>
                            <article class="wm-task"><h4>Quarterly release notes</h4><p>Owner <b>Huy</b> · Requestor <b>Mai</b></p><div><em>P3</em><span>Due 1/3</span><span>Marketing</span></div></article>
                            <article class="wm-task"><h4>Prepare sprint plan</h4><p>Owner <b>Nam</b> · Requestor <b>An</b></p><div><em>P2</em><span>Due 1/6</span><span>Product</span></div></article>
                            <button class="wm-add">＋ Add item</button>
                        </div>
                    </div>

                    <button class="wm-floating-add" type="button">＋ <span>Add Item</span></button>
                </div>
            </div>
        </div>
    </div>
</section>
