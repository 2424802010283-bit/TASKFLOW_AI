<link rel="stylesheet" href="platform-companies.css">

<section class="platform-companies" id="platform-companies">
    <div class="platform-companies__inner">

        <div class="platform-switcher" role="tablist" aria-label="TaskFlow platform">
            <button type="button" class="platform-switcher__item" data-tab="knowledge">Knowledge</button>
            <button type="button" class="platform-switcher__item" data-tab="people">People</button>
            <button type="button" class="platform-switcher__item" data-tab="process">Process</button>
            <button type="button" class="platform-switcher__item is-active" data-tab="platform">Platform</button>
        </div>

        <h2 class="platform-companies__title">
            The most innovative teams run their work in TaskFlow.
        </h2>

        <div class="company-stage" data-company-stage>

            <article class="company-card company-card--side" data-company-card>
                <div class="company-card__visual company-card__visual--flowai">
                    <span class="company-brand company-brand--open">FlowAI</span>
                    <div class="flow-orb"></div>
                    <div class="flow-lines"></div>
                </div>
                <div class="company-card__copy">
                    <strong>FlowAI</strong>
                    <span>Turn team knowledge into action.</span>
                </div>
            </article>

            <article class="company-card company-card--featured is-active" data-company-card>
                <div class="company-card__visual company-card__visual--workspace">
                    <div class="workspace-bar">
                        <span></span><span></span><span></span>
                        <b>TaskFlow Workspace</b>
                    </div>
                    <div class="workspace-grid">
                        <div class="workspace-person"></div>
                        <div class="workspace-screen screen-one"></div>
                        <div class="workspace-screen screen-two"></div>
                    </div>
                    <div class="workspace-caption">
                        <small>NORTHSTAR</small>
                        <strong>TaskFlow helps teams turn collaboration into progress.</strong>
                    </div>
                    <button class="company-play" type="button" aria-label="Play TaskFlow story">▶</button>
                </div>
            </article>

            <article class="company-card company-card--side" data-company-card>
                <div class="company-card__visual company-card__visual--mobile">
                    <div class="phone">
                        <div class="phone-screen">
                            <small>TaskFlow</small>
                            <strong>Project<br>update</strong>
                            <span>All systems<br>moving forward</span>
                        </div>
                    </div>
                </div>
                <div class="company-card__copy">
                    <strong>Project teams</strong>
                    <span>Stay aligned wherever work happens.</span>
                </div>
            </article>

            <article class="company-card company-card--side" data-company-card>
                <div class="company-card__visual company-card__visual--car">
                    <span class="car-light"></span>
                    <span class="car-body"></span>
                </div>
                <div class="company-card__copy">
                    <strong>Modern teams</strong>
                    <span>Move from conversation to action.</span>
                </div>
            </article>

        </div>

        <div class="platform-actions">
            <a href="/Auth/Register" class="platform-btn platform-btn--primary">GET STARTED</a>
            <a href="#pricing" class="platform-btn platform-btn--secondary">FIND YOUR PLAN</a>
        </div>
    </div>

    <div class="platform-companies__wave" aria-hidden="true"></div>
</section>

<section class="platform-followup">
    <div class="platform-followup__inner">
        <h2>We’re in the business of growing teams.</h2>

        <ul class="platform-stats">
            <li class="platform-stat">
                <span class="platform-stat__number" data-count-to="26" data-suffix="%">26%</span>
                <p class="platform-stat__text">of users say TaskFlow helps them stay more connected<sup>4</sup></p>
            </li>
            <li class="platform-stat">
                <span class="platform-stat__number" data-count-to="11">11</span>
                <p class="platform-stat__text">The average number of apps used by teams in TaskFlow<sup>3</sup></p>
            </li>
            <li class="platform-stat">
                <span class="platform-stat__number" data-count-to="23" data-suffix="%">23%</span>
                <p class="platform-stat__text">of users say TaskFlow helps them collaborate more efficiently<sup>4</sup></p>
            </li>
        </ul>
    </div>
</section>

@* <script src="platform-companies.js"></script> *@