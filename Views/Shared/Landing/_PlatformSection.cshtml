<section class="tf-platform" id="platform-section">
    <div class="platform-glow platform-glow-left"></div>
    <div class="platform-glow platform-glow-right"></div>

    <div class="platform-container">
        <div class="platform-switcher" role="tablist" aria-label="TaskFlow platform views">
            <button type="button" class="platform-tab" data-platform-tab="knowledge">Knowledge</button>
            <button type="button" class="platform-tab" data-platform-tab="people">People</button>
            <button type="button" class="platform-tab" data-platform-tab="process">Process</button>
            <button type="button" class="platform-tab is-active" data-platform-tab="platform">Platform</button>
        </div>

        <header class="platform-heading">
            <h2>Secure. Scalable. <span>Silo-free.</span></h2>
            <p>
                TaskFlow brings your conversations, projects, meetings, and AI-powered workflows
                together in one flexible platform built for the way your team works.
            </p>
        </header>

        <div class="platform-content">
            <div class="platform-story">
                <button type="button" class="platform-story-item is-active" data-platform-story="integrations">
                    <span class="platform-story-line"></span>
                    <span class="platform-story-copy">
                        <strong>Connect the tools you already use.</strong>
                        <small>Bring files, meetings, project data, and everyday tools into one connected workspace.</small>
                        <span class="platform-link">Explore integrations <b>→</b></span>
                    </span>
                </button>

                <button type="button" class="platform-story-item" data-platform-story="customize">
                    <span class="platform-story-line"></span>
                    <span class="platform-story-copy">
                        <strong>Customize TaskFlow to fit your needs.</strong>
                    </span>
                </button>

                <button type="button" class="platform-story-item" data-platform-story="reliable">
                    <span class="platform-story-line"></span>
                    <span class="platform-story-copy">
                        <strong>Work with confidence.</strong>
                    </span>
                </button>

                <div class="platform-quote">
                    <span class="platform-quote-mark">✦</span>
                    <p>One connected workspace gives your team the context it needs to move work forward.</p>
                    <strong>TaskFlow Platform</strong>
                </div>
            </div>

            <div class="platform-product" aria-label="TaskFlow integrations preview">
                <div class="platform-window">
                    <div class="platform-window-bar">
                        <div class="platform-dots"><i></i><i></i><i></i></div>
                        <div class="platform-window-title">TaskFlow · App Center</div>
                        <div class="platform-window-actions"><span>←</span><span>→</span><span>◷</span></div>
                    </div>

                    <div class="platform-app-shell">
                        <aside class="platform-mini-nav">
                            <div class="platform-brand-mark">T</div>
                            <button class="active">⌂<small>Home</small></button>
                            <button>◌<small>Chats</small></button>
                            <button>✓<small>Tasks</small></button>
                            <button>◫<small>Files</small></button>
                            <button>✦<small>FlowBot</small></button>
                            <span></span>
                            <button>•••<small>More</small></button>
                        </aside>

                        <div class="platform-main-panel">
                            <div class="platform-topbar">
                                <div class="platform-search">⌕ <span>Search apps and integrations</span></div>
                                <div class="platform-user-actions">
                                    <span>Updated just now</span>
                                    <span class="platform-avatar">S</span>
                                    <button>?</button>
                                </div>
                            </div>

                            <div class="platform-page-head">
                                <div>
                                    <h3>Apps & integrations</h3>
                                    <p>Connect TaskFlow with the tools your team uses every day.</p>
                                </div>
                                <button class="platform-outline-button">Manage connections</button>
                            </div>

                            <div class="platform-filter-row">
                                <div class="platform-filter-search">⌕ <span>Search by app name or category</span></div>
                                <button>All apps⌄</button>
                            </div>

                            <div class="platform-app-grid">
                                <article class="platform-app-card featured">
                                    <div class="platform-app-icon icon-drive">△</div>
                                    <div><h4>Google Drive</h4><p>Files & documents</p></div>
                                    <span class="connected">Connected</span>
                                </article>
                                <article class="platform-app-card">
                                    <div class="platform-app-icon icon-meet">▣</div>
                                    <div><h4>Google Meet</h4><p>Meetings & calls</p></div>
                                    <button>Connect</button>
                                </article>
                                <article class="platform-app-card">
                                    <div class="platform-app-icon icon-github">●</div>
                                    <div><h4>GitHub</h4><p>Code & development</p></div>
                                    <button>Connect</button>
                                </article>
                                <article class="platform-app-card">
                                    <div class="platform-app-icon icon-notion">N</div>
                                    <div><h4>Notion</h4><p>Knowledge & notes</p></div>
                                    <button>Connect</button>
                                </article>
                                <article class="platform-app-card">
                                    <div class="platform-app-icon icon-calendar">31</div>
                                    <div><h4>Calendar</h4><p>Schedules & events</p></div>
                                    <span class="connected">Connected</span>
                                </article>
                                <article class="platform-app-card">
                                    <div class="platform-app-icon icon-mail">✉</div>
                                    <div><h4>Email</h4><p>Messages & notifications</p></div>
                                    <button>Connect</button>
                                </article>
                                <article class="platform-app-card">
                                    <div class="platform-app-icon icon-jira">◆</div>
                                    <div><h4>Jira</h4><p>Issues & delivery</p></div>
                                    <button>Connect</button>
                                </article>
                                <article class="platform-app-card">
                                    <div class="platform-app-icon icon-zapier">Z</div>
                                    <div><h4>Automation</h4><p>Connect your workflows</p></div>
                                    <button>Connect</button>
                                </article>
                                <article class="platform-app-card flowbot-card">
                                    <div class="platform-app-icon icon-flowbot">✦</div>
                                    <div><h4>FlowBot</h4><p>AI assistance on demand</p></div>
                                    <span class="connected">Built in</span>
                                </article>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="platform-bottom-note">
            <span>Built to connect your team's work.</span>
            <a href="#">See how TaskFlow integrations work <b>→</b></a>
        </div>
    </div>
</section>
    