                </div>


                <!-- Item 2 -->
                <div class="context-feature">
                    <div class="context-feature-icon">
                        ✦
                    </div>

                    <div class="context-feature-content">
                        <h3>
                            One search to find everything.
                        </h3>

                        <p>
                            TaskFlow connects conversations, projects,
                            files and tasks so your team can find the
                            information they need quickly.
                        </p>
                    </div>
                </div>


                <!-- Item 3 -->
                <div class="context-feature">
                    <div class="context-feature-icon">
                        ◌
