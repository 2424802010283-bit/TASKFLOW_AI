<!-- =====================================================
             FLOWBOT
        ====================================================== -->

<section class="bot"
         id="bot">


    <!-- =================================================
                 FLOWBOT HEADER
            ================================================== -->

    <div class="hd">


        <h2>


            <span class="logo">

                <i style="left:0;
                    top:0;
                    background:#36c5f0">
                </i>

                <i style="right:0;
                    top:0;
                    background:#2eb67d">
                </i>

                <i style="left:0;
                    bottom:0;
                    background:#e01e5a">
                </i>

                <i style="right:0;
                    bottom:0;
                    background:#ecb22e">
                </i>

            </span>


            FlowBot

        </h2>


        <div class="r">

            <span>
                ⌕
            </span>

            <span>
                ⋮
            </span>

            <span onclick="document.getElementById('bot').classList.add('hide')"
                  style="cursor:pointer">

                ✕

            </span>

        </div>

    </div>



    <!-- =================================================
                 FLOWBOT TABS
            ================================================== -->

    <div class="tabs">

        <span class="a">
            ○ Messages
        </span>

        <span class="t">
            ▢ Add a canvas
        </span>

        <span class="t">
            +
        </span>

    </div>



    <!-- =================================================
                 FLOWBOT CONTENT
            ================================================== -->

    <div class="sc"
         id="bsc">


        <!-- =================================================
                     UPGRADE PANEL
                ================================================== -->

        <div class="up"
             id="up">


            <span class="x"
                  onclick="document.getElementById('up').classList.toggle('min')">
            </span>


            <h3>
                Upgrade to use all FlowBot features
            </h3>


            <p>
                FlowBot has new AI features,
                but some advanced capabilities are only available
                with certain paid plans.
            </p>


            <div class="row">

                <button>
                    🚀 Upgrade your plan
                </button>

                <a>
                    Learn more
                </a>

            </div>

        </div>



        <!-- =================================================
                     FLOWBOT TEXT
                ================================================== -->

        <div class="btxt"
             id="btxt">


            <p>
                Need help? Find more
                <a>
                    support
                </a>
                online!
            </p>


            <p>
                However, I am not human.
                I am just a bot — a simple bot without too many
                tricks up my electronic sleeve.
                But I’m glad you’re here!
            </p>

        </div>

    </div>



    <!-- =================================================
                 FLOWBOT COMPOSER
            ================================================== -->

    <div class="comp">


        <div class="tb">

            <b>
                B
            </b>

            <i>
                I
            </i>

            <u>
                U
            </u>

            <s>
                S
            </s>

            <span>
                |
            </span>

            <span>
                🔗
            </span>

            <span>
                ≡
            </span>

            <span>
                ☰
            </span>

            <span>
                |
            </span>

            <span>
                ▤
            </span>

            <span>
                &lt;/&gt;
            </span>

            <span>
                ⌘
            </span>

        </div>


        <div class="in"
             id="bin"
             contenteditable="true"
             data-ph="Send a message to FlowBot">
        </div>


        <div class="bt">

            <span class="pl">
                +
            </span>

            <span style="text-decoration:underline">
                Aa
            </span>
    
            <span>
                ☺
            </span>

            <span>
                @@
            </span>

            <span>
                ⋯
            </span>

            <span class="snd">

                ➤

                <small>
                    ⌄
                </small>

            </span>

        </div>

    </div>

</section>

</div>
